
{
  "data_asset_type": null,
  "expectation_suite_name": "silver_charts_suite",
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_set",
      "kwargs": {
        "column_set": [
          "track_title",
          "chart_rank",
          "chart_date",
          "chart_artist",
          "track_url",
          "region",
          "chart_type",
          "trend",
          "streams",
          "track_id",
          "has_streams"
        ],
        "exact_match": false
      },
      "meta": {
        "dimension": "schema",
        "description": "Silver charts must contain standardized column names and extracted track_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "chart_date"
      },
      "meta": {
        "dimension": "nulls",
        "description": "chart_date must not be null"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "chart_rank"
      },
      "meta": {
        "dimension": "nulls",
        "description": "chart_rank must not be null"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "region"
      },
      "meta": {
        "dimension": "nulls",
        "description": "chart region must not be null"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "chart_type"
      },
      "meta": {
        "dimension": "nulls",
        "description": "chart type must not be null"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "track_id"
      },
      "meta": {
        "dimension": "nulls",
        "description": "track_id parsed from URL must not be null"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "chart_rank",
        "min_value": 1,
        "max_value": 200
      },
      "meta": {
        "dimension": "chart_positions",
        "description": "chart rank must be between 1 and 200"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "chart_type",
        "value_set": [
          "top200",
          "viral50"
        ]
      },
      "meta": {
        "dimension": "chart_positions",
        "description": "chart_type must be top200 or viral50"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "trend",
        "value_set": [
          "SAME_POSITION",
          "MOVE_UP",
          "MOVE_DOWN",
          "NEW_ENTRY"
        ]
      },
      "meta": {
        "dimension": "chart_positions",
        "description": "trend must be one of the 4 Spotify trend categories"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "chart_date",
        "regex": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "meta": {
        "dimension": "dates",
        "description": "chart_date must conform to ISO 8601 YYYY-MM-DD"
      }
    },
    {
      "expectation_type": "expect_compound_columns_to_be_unique",
      "kwargs": {
        "column_list": [
          "chart_date",
          "region",
          "chart_type",
          "chart_rank"
        ]
      },
      "meta": {
        "dimension": "duplicates",
        "description": "Primary grain (date, region, chart type, rank) must be unique"
      }
    }
  ],
  "ge_cloud_id": null,
  "meta": {
    "great_expectations_version": "1.24.1",
    "author": "Member 4 (Data Quality & Workflow Orchestration)",
    "suite_name": "silver_charts_suite"
  }
}
